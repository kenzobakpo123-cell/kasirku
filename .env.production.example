# Template untuk Vercel / Docker production. Jangan commit nilai aslinya.
# MySQL cloud: pakai connection string publik dari provider (Aiven, Railway TCP proxy, dll).
DATABASE_URL="mysql://user:pass@host:3306/kasirku"

# Wajib: string acak minimal 32 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Base URL deployed, wajib HTTPS. Dipakai untuk CSRF dan link verifikasi/reset.
NEXT_PUBLIC_APP_URL="https://kasirku.vercel.app"

# Opsional: proteksi rate limit terpusat. Kosongkan untuk fallback in-memory.
ARCJET_KEY=""

# Wajib di production: verifikasi email, reset password, dan struk otomatis.
RESEND_API_KEY=""
EMAIL_FROM="Kasirku <halo@domainkamu.com>"

# Komisi agensi (0.15 = 15%)
AGENCY_COMMISSION_RATE="0.15"

# Opsional: Midtrans. Kosongkan untuk transfer manual.
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
