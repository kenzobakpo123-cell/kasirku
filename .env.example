# Database (MySQL/XAMPP). project ke-1 pakai database `keuangan` di server yang sama;
# Kasirku memakai database terpisah `kasirku` dengan user sendiri.
DATABASE_URL="mysql://kasirku:kasirku-rahasia@localhost:3306/kasirku"
MYSQL_DATABASE="kasirku"
MYSQL_USER="kasirku"
MYSQL_PASSWORD="kasirku-rahasia"
MYSQL_ROOT_PASSWORD="kasirku-root-rahasia"

# Wajib: string acak minimal 32 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Base URL aplikasi (untuk link struk & email)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opsional: proteksi/write-rate. Kosongkan untuk rate limiter in-memory saat development.
ARCJET_KEY=""

# Opsional: verifikasi email & reset password.
RESEND_API_KEY=""
EMAIL_FROM="Kasirku <onboarding@resend.dev>"

# Komisi agensi dari transaksi klien yang direferensikan (0.15 = 15%)
AGENCY_COMMISSION_RATE="0.15"
