# Database (MySQL/XAMPP). project ke-1 pakai database `keuangan` di server yang sama;
# Kasirku memakai database terpisah `kasirku` dengan user sendiri.
DATABASE_URL="mysql://kasirku:kasirku-rahasia@localhost:3306/kasirku"
# Opsional, hanya untuk `prisma migrate dev` di lokal:
# SHADOW_DATABASE_URL="mysql://kasirku:kasirku-rahasia@localhost:3306/kasirku_shadow"
# lalu: npx prisma migrate dev --shadow-database-url "$env:SHADOW_DATABASE_URL"
MYSQL_DATABASE="kasirku"
MYSQL_USER="kasirku"
MYSQL_PASSWORD="kasirku-rahasia"
MYSQL_ROOT_PASSWORD="kasirku-root-rahasia"

# Wajib: string acak minimal 32 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Base URL aplikasi (untuk link struk & email)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opsional: proteksi/write-rate. Kosongkan untuk rate limiter in-memory saat development.
ARCJET_KEY=""

# Opsional: verifikasi email, reset password, dan struk email.
# Wajib di production jika ingin struk email benar-benar terkirim.
RESEND_API_KEY=""
EMAIL_FROM="Kasirku <onboarding@resend.dev>"

# Opsional: struk WhatsApp otomatis lewat WhatsApp Business Cloud API.
# Tanpa keduanya, development membuka wa.me ke nomor pembeli dengan pesan siap kirim.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"

# Komisi agensi dari transaksi klien yang direferensikan (0.15 = 15%)
AGENCY_COMMISSION_RATE="0.15"

# Opsional: pembayaran otomatis Midtrans. Kosongkan untuk mode transfer manual.
# Sandbox: https://dashboard.sandbox.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
# Webhook: POST {NEXT_PUBLIC_APP_URL}/api/billing/midtrans/webhook

